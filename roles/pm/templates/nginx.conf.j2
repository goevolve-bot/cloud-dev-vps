# Trust Cloudflare's edge: the origin is only ever reached through Cloudflare
# (Full strict — see docs/pm-system-plan.md), which always connects over
# HTTPS/443, so there is no plaintext :80 listener here at all.  The realip
# module recovers the true client IP from the CF-Connecting-IP header, but
# only for connections that actually originate from a Cloudflare IP —
# set_real_ip_from is the trust list.  Once trusted, nginx rewrites
# $remote_addr itself, so proxy_set_header X-Real-IP $remote_addr (and access
# logs, rate limiting, etc.) all see the real visitor IP.
#
# This file is rendered by Ansible (roles/pm T40) — do not edit the *output* by
# hand.  IP ranges come from roles/pm/defaults/main.yml (cloudflare_ipv4/6_ranges).
# app/nginx/nginx.conf is the local-dev copy of the rendered result and must be
# updated alongside any change here.
#
# `location /` proxies everything to the pm container, which serves both /api
# and the built SPA (app/server/Dockerfile builds web/dist; app.ts serves it
# with an index.html fallback) — so a single upstream is correct.
{% for cidr in cloudflare_ipv4_ranges %}
set_real_ip_from {{ cidr }};
{% endfor %}
{% for cidr in cloudflare_ipv6_ranges %}
set_real_ip_from {{ cidr }};
{% endfor %}
real_ip_header CF-Connecting-IP;
real_ip_recursive off;

server {
    listen 443 ssl;
    server_name _;

    ssl_certificate     /etc/nginx/certs/origin.crt;
    ssl_certificate_key /etc/nginx/certs/origin.key;

    auth_basic           "pm";
    auth_basic_user_file /etc/nginx/auth/htpasswd;

    # SSE-friendly: don't buffer responses, let events reach the client as
    # they are written (see /api/runs/:id/events, T20).
    proxy_buffering off;

    location / {
        proxy_pass http://pm:{{ pm_backend_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }
}
